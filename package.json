{
  "name": "outro-desktop",
  "version": "1.0.0",
  "description": "Outro — watch together",
  "main": "main.js",
  "author": "marl",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.marl.outro",
    "productName": "Outro",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.0.0"
  }
}